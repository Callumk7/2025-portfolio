---
interface Props {
	title: string;
	companyName: string;
	startDate: Date;
	endDate?: Date;
}

import { formatDate } from "~/utils/date";

const { title, companyName, startDate, endDate } = Astro.props;

const formatExperienceDate = (date: Date) =>
	formatDate(date, {
		year: "numeric",
		month: "long",
	});
---

<div>
	<h4>{title}</h4>
	<p class="bold">{companyName}</p>
	<p>
		{formatExperienceDate(startDate)}
		{endDate ? ` - ${formatExperienceDate(endDate)}` : " - Present"}
	</p>
	<slot />
</div>

<style lang="scss">
	div {
		padding: 1rem;
	}

	h4 {
		margin-bottom: 0.2rem;
	}

	.bold {
		font-weight: 600;
	}
</style>
